# Application Configuration
PROJECT_NAME="Geospatial File Measurement API"
API_V1_STR="/api"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration
# SQLite for local development (defaults to data/geospatial.db)
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/geospatial_db
DATABASE_URL="sqlite:///./data/geospatial.db"

# Storage & Upload Limits
UPLOAD_DIR="./data/uploads"
TEMP_DIR="./data/temp"
MAX_UPLOAD_SIZE_MB=50

# Geospatial Settings
# Fallback projected CRS when local UTM projection cannot be determined
DEFAULT_PROJECTED_CRS_FALLBACK="EPSG:3857"

# CARTO Configuration
CARTO_API_BASE_URL="https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=your_carto_basemap_key"
CARTO_API_KEY="your_carto_basemap_key"
